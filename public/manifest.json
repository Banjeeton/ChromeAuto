{
  "manifest_version": 3,
  "name": "Chrome Automation Extension",
  "description": "Record, edit and run website automations in current Chrome tabs.",
  "version": "0.1.0",
  "minimum_chrome_version": "118",
  "permissions": ["debugger", "sidePanel", "storage"],
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Open Chrome Automation"
  },
  "side_panel": {
    "default_path": "index.html"
  }
}
